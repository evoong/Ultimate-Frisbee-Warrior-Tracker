# @posthog/ai@8.10.1 declares an optional peer of @google/genai@^1.52.0, but
# this project runs @google/genai@^2.x. The range is stale metadata, not a real
# incompatibility — the wrapper proxies straight through to genai 2.x (verified
# end-to-end against the live API). npm's default strict peer resolution turns
# that into a hard ERESOLVE, which fails `npm ci` in CI and `npm install` on
# Vercel. No published @posthog/ai accepts genai 2.x yet, and downgrading genai
# to 1.x would be a real regression, so accept the resolution explicitly.
# Revisit once @posthog/ai widens the range.
legacy-peer-deps=true
